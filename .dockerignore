# V1.9.93: allowlist, not denylist. The build context holds only what the Dockerfile COPYs; everything else
# (secrets, deploy/ instance files, backups, .git, local data) never reaches the daemon or a layer.
*

# Allowlist: exactly the sources of the Dockerfile's COPY instructions.
!gradlew
!gradlew.bat
!build.gradle.kts
!settings.gradle.kts
!gradle.properties
!gradle/
!lapis-shared/
!lapis-server/
!lapis-client/
!lapis-detekt-rules/
!docs-render/

# Re-excluded inside the allowed directories.
**/build
**/.gradle
**/.kotlin
**/node_modules
**/.env
**/.env*
**/*.env
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.jks
**/*.keystore
**/*.dump
**/*.dump.gz
**/*.sql.gz
**/backups/
**/*.pmtiles
**/*.hprof
**/hs_err_pid*.log
**/.DS_Store
**/.idea
**/.claude

# Already excluded by `*`; listed for documentation. NOT excluded on purpose: lapis-client/.kotlin-js-store/yarn.lock
# (lockfile of the webpack build -- a hidden directory, so never exclude by a `.*` pattern) and the tracked
# geodata resource lapis-server/src/main/resources/geodata/de-postal-centroids.csv (CC-BY GeoNames, shipped in the jar).
.git
deploy
import-data
*.import-report.csv
config
