<configuration>
    <!--
        V1.9.65 log privacy. A failed SQL statement puts the statement text AND the offending values into the exception
        message (`Detail: Key (email)=(...)`, Exposed's `SQL: [INSERT ...]`), and Kilua RPC logs every non-service
        exception with LOG.error(e.getMessage(), e) (message plus full cause chain). These two converters redact SQL
        text and values for EVERY logger; SQLSTATE, exception classes, constraint/table name and all stack frames stay.
        Do NOT use the raw tokens %msg, %m, %message, %ex, %xEx, %rEx, %throwable (or their long forms) in any pattern of
        this file: they bypass the redaction. the tripwire test in LogbackSqlRedactionScenarios (run as LogbackSqlRedactionTest) fails the build if one appears.
        Logback 1.6 reads the converter class from the `class` attribute.
    -->
    <conversionRule conversionWord="safeMsg" class="network.lapis.cloud.server.logging.SqlSafeMessageConverter" />
    <conversionRule conversionWord="safeEx" class="network.lapis.cloud.server.logging.SqlSafeThrowableProxyConverter" />

    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %safeMsg%n%safeEx</pattern>
        </encoder>
    </appender>

    <!--
        Security-Audit-Runde 1 / S2: the Price-Oracle (network.lapis.cloud.server.economy.oracle)
        deliberately never installs Ktor's `Logging` plugin, specifically because two of its sources
        (MetalpriceAPI, Alpha Vantage) carry their API key in the request URL's query string, and that
        plugin would put the full URL straight into the log (see OracleHttpClient.kt's
        oracleHttpClient() KDoc). But Ktor's OWN internal client plugins (SaveBody, HttpTimeout,
        HttpCallValidator) independently log `request.url` verbatim at TRACE level on code paths
        every oracle request always executes; avoiding the Logging plugin alone does NOT prevent
        this. Re-checked against the 3.5.2 changelog (dependency-bump wave, 2026-09-08): no new
        logger names or logging-infrastructure changes landed, floor is still current. Without an
        explicit floor here, an operator raising the root (or `io.ktor`)
        level to DEBUG/TRACE for troubleshooting, a normal, expected diagnostic step when a gold
        source starts failing, would leak the query-string API keys into stdout/the Docker log
        driver/any log aggregator in cleartext. Do NOT remove this floor "to see more Ktor detail";
        raise it on a narrower, non-`io.ktor.client` logger instead, or accept the leak risk
        explicitly and briefly.
    -->
    <logger name="io.ktor.client" level="INFO" />

    <!--
        Exposed logs the failed statement WITH its values at DEBUG ("Transaction attempt #N failed ... Statement(s): ...").
        Same reasoning as the io.ktor.client floor above: an operator raising the level for troubleshooting must not get
        statements with personal data into the log.
    -->
    <logger name="Exposed" level="INFO" />

    <root level="INFO">
        <appender-ref ref="STDOUT" />
    </root>
</configuration>
