<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!--
        Security-Audit-Runde 1 / S2: the Price-Oracle (network.lapis.cloud.server.economy.oracle)
        deliberately never installs Ktor's `Logging` plugin, specifically because two of its sources
        (MetalpriceAPI, Alpha Vantage) carry their API key in the request URL's query string, and that
        plugin would put the full URL straight into the log (see OracleHttpClient.kt's
        oracleHttpClient() KDoc). But Ktor 3.5.1's OWN internal client plugins (SaveBody,
        HttpTimeout, HttpCallValidator) independently log `request.url` verbatim at TRACE level on
        code paths every oracle request always executes; avoiding the Logging plugin alone does NOT
        prevent this. Without an explicit floor here, an operator raising the root (or `io.ktor`)
        level to DEBUG/TRACE for troubleshooting, a normal, expected diagnostic step when a gold
        source starts failing, would leak the query-string API keys into stdout/the Docker log
        driver/any log aggregator in cleartext. Do NOT remove this floor "to see more Ktor detail";
        raise it on a narrower, non-`io.ktor.client` logger instead, or accept the leak risk
        explicitly and briefly.
    -->
    <logger name="io.ktor.client" level="INFO" />

    <root level="INFO">
        <appender-ref ref="STDOUT" />
    </root>
</configuration>
