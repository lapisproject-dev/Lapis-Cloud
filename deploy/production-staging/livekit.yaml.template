# Lapis Cloud -- STAGING instance LiveKit config. This is a TEMPLATE, not the real file: the
# placeholders below are substituted from deploy/production-staging/.env by render-secrets.sh (see
# ../production/README.adoc "Video conferencing"). The rendered livekit.yaml is gitignored -- never
# commit it.
#
# tcp_port/udp_port are 7901/7902 here -- disjoint from PdV's (7881/7882) and ELB's (7891/7892), see
# docker-compose.yml's own port-scheme comment and ../production-elb/livekit.yaml.template's own
# explanation of why these two specifically cannot just be host-side remapped.
port: 7880

rtc:
  tcp_port: 7901
  udp_port: 7902
  use_external_ip: false
  node_ip: ${LAPIS_PUBLIC_IP}

turn:
  enabled: false

room:
  empty_timeout: 300
  max_participants: 25

keys:
  ${LAPIS_LIVEKIT_API_KEY}: ${LAPIS_LIVEKIT_API_SECRET}

logging:
  level: info

redis:
  address: redis:6379
