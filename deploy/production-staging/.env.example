# Copy to .env in this same directory and fill in real values. .env is gitignored -- never commit
# real secrets here or anywhere else in the repo.
#
# This file is a trimmed copy of ../production-elb/.env.example: only the variables
# docker-compose.yml in THIS directory actually forwards are listed (SMTP/SEPA-poller/
# Dunning-poller/outbound-webhooks are hardcoded OFF in docker-compose.yml itself here, see
# README.adoc "What is deliberately off" -- no .env entries for them exist to accidentally set).

LAPIS_DB_NAME=lapiscloud_staging
LAPIS_DB_USER=lapiscloud_staging
# Generate with: openssl rand -base64 24
LAPIS_DB_PASSWORD=

# The public HTTPS origin this deployment is reachable at -- e.g. https://staging.parteidervernunft.de
LAPIS_PUBLIC_BASE_URL=

# --- Video conferencing (see ../production/README.adoc "Video conferencing" for the full setup) ---
LAPIS_PUBLIC_IP=
# Arbitrary identifier, not a secret itself -- e.g. lapiscloud-staging
LAPIS_LIVEKIT_API_KEY=
# Generate with: openssl rand -base64 32 (nimbus-jose-jwt refuses HMAC keys under 256 bits/32 bytes)
LAPIS_LIVEKIT_API_SECRET=
# Generate with: openssl rand -base64 32. Different from the above -- never reuse one secret for
# both LiveKit and coturn.
LAPIS_TURN_SECRET=
# Public wss:// origin -- e.g. wss://video-staging.parteidervernunft.de
LAPIS_LIVEKIT_URL=
# OPTIONAL -- TURNS relay endpoint, see README.adoc "TURNS over TLS" (Offene Frage O-3: only set
# this up if the staging instance should also exercise the TURNS path).
LAPIS_TURNS_URLS=

# AES-256-GCM key for streaming destination secrets. Generate with: openssl rand -base64 32
LAPIS_SECRET_ENCRYPTION_KEY=

# --- White-Label-Branding -- OPTIONAL ---
LAPIS_BRAND_TITLE=Testverein Musterstadt e.V. (STAGING)
LAPIS_BRAND_LOGO_PATH=
LAPIS_BRAND_WEBSITE_URL=

# --- Rechtstexte (Impressum/Datenschutz) -- OPTIONAL, rein fiktive Platzhalterwerte reichen hier ---
LAPIS_LEGAL_OPERATOR_NAME=Testverein Musterstadt e.V.
LAPIS_LEGAL_STREET=Musterweg 1
LAPIS_LEGAL_POSTAL_CODE=12345
LAPIS_LEGAL_CITY=Musterstadt
LAPIS_LEGAL_COUNTRY=Deutschland
LAPIS_LEGAL_CONTACT_EMAIL=
LAPIS_LEGAL_REPRESENTATIVE=
LAPIS_LEGAL_PHONE=
LAPIS_LEGAL_REGISTER_COURT=
LAPIS_LEGAL_REGISTER_NUMBER=
LAPIS_LEGAL_VAT_ID=
LAPIS_LEGAL_DPO_CONTACT=
LAPIS_LEGAL_MSTV_RESPONSIBLE=
LAPIS_LEGAL_SUPERVISORY_AUTHORITY=

# --- Oeffentliche Website-Integration -- OPTIONAL, default aus ---
LAPIS_EMBED_ENABLED=
LAPIS_EMBED_ALLOWED_ORIGINS=

# --- Staging-Seed-Mechanismus (siehe StagingSeedConfig KDoc + README.adoc "Staging seed
# mechanism") -- DAS ist der Grund, warum dieses Verzeichnis ueberhaupt existiert ---
# Muss exakt der String "true" sein (case-sensitiv) -- alles andere (leer, "True", "1", ...) laesst
# den Server ganz normal OHNE Seeding starten (Disabled), wie eine gewoehnliche leere Instanz.
LAPIS_STAGING_MODE=true
# PFLICHT sobald LAPIS_STAGING_MODE=true -- KEIN Default. Fehlt dieser Wert (oder ist er zu
# schwach, oder identisch mit dem im Quellcode veroeffentlichten DevSeedData.DEMO_PASSWORD), bricht
# der Server-Start mit einer klaren Fehlermeldung ab (fail-fast, siehe StagingSeedConfig KDoc).
# Mindestens 12, hoechstens 128 Zeichen. Generate with: openssl rand -base64 24
LAPIS_STAGING_SEED_PASSWORD=
