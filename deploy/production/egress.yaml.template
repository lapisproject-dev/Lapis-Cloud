# Lapis Cloud -- PRODUCTION Egress config (Videokonferenzen Wave 2 "Aufzeichnung" + Wave 3
# "Externes Streaming"). This is a TEMPLATE, not the real file: the placeholders below are
# substituted from deploy/production/.env by render-secrets.sh (see README.adoc "Video
# conferencing"). The rendered egress.yaml is gitignored -- never commit it.
#
# Mirrors deploy/local/egress.yaml's structure (see that file's own extensive comments for the full
# rationale) -- the server records raw per-participant tracks in real time via LiveKit Track Egress
# (Wave 2), and the same egress service also drives Room/Participant Composite Egress for external
# RTMP streaming (Wave 3, ConferenceStreamDestinationsScreen). `api_key`/`api_secret` below MUST
# equal livekit.yaml's own rendered `keys:` entry byte-for-byte -- egress authenticates against the
# LiveKit server's Twirp API using the SAME admin credential LiveKitEgressClient/LiveKitAdminClient
# mint tokens against -- and `redis.address` MUST equal livekit.yaml's own `redis:` block.
log_level: info
api_key: ${LAPIS_LIVEKIT_API_KEY}
api_secret: ${LAPIS_LIVEKIT_API_SECRET}
ws_url: ws://livekit:7880 # compose service name, NOT localhost -- resolved inside the container
insecure: true # plain ws:// -- compose-internal traffic only, never reaches the public internet,
# same trust boundary LAPIS_LIVEKIT_API_URL (http://livekit:7880) already uses for Wave 1.
redis:
  address: redis:6379

# Wave 3 "Externes Streaming" -- Room-Composite egress (ConferenceStreamLayout.GRID/SPEAKER) renders
# through a web page loaded by Chrome INSIDE the egress container.
#
# CORRECTED 2026-08-15 (was wrong before): despite older assumptions about a hosted
# `https://template.livekit.io` default, the actual v1.13.0 binary bundles the templates INSIDE
# itself (`cmd/server/main.go`: `//go:embed templates` + `svc.StartTemplatesServer(rfs)`) -- the
# `template-default` React app is compiled and embedded into the Go binary at build time, never
# written to disk as loose `.html` files (which is why an earlier `find -name '*.html'` check in this
# repo's history found nothing and wrongly concluded there was no local template). `pkg/config`:
# `defaultTemplateBase = "http://localhost:%d/"`, `defaultTemplatePort = 7980` -- this embedded
# server runs on :7980 inside the SAME container whenever `template_base` is unset, exactly as below.
# Verified live: `curl localhost:7980/` inside the egress container returns 200. No external
# reachability, no self-hosted mirror, and no `template_base` override are needed for the built-in
# templates to work -- do NOT uncomment the line below on the assumption that fixes anything; it did
# not, in either direction.
#
# The REAL cause of "Start signal not received" (code 412) on GRID/SPEAKER, found the same day: this
# service's default 64MB /dev/shm is too small for Chrome's renderer/GPU buffers -- Chrome loads the
# (working, local) template page but the render pipeline never reaches a ready state, egress waits out
# its own startup timeout and aborts. Fixed via this service's own `shm_size: 1gb` setting below, not
# via anything in this file. ConferenceStreamLayout.SINGLE_PARTICIPANT (StartParticipantEgress) never
# launches Chrome at all and was unaffected throughout -- useful as an immediate fallback if GRID/
# SPEAKER ever regress again.
#
# `template_base` remains available for a genuinely CUSTOM template (different branding/layout, not a
# reachability workaround) -- point it at a `livekit/egress-templates`-based mirror if/when that need
# arises:
# template_base: http://your-custom-template-server:PORT
