# Lapis Cloud -- PRODUCTION coturn config. This is a TEMPLATE, not the real file: the placeholders
# below are substituted from deploy/production/.env by render-secrets.sh (see README.adoc "Video
# conferencing"). The rendered turnserver.conf is gitignored -- never commit it.
#
# Mirrors deploy/local/turnserver.conf (see that file's own header for why `use-auth-secret`/
# `static-auth-secret` is used instead of a static long-term username/credential pair -- coturn's
# REST-API shared-secret scheme, same as dev: this value is never itself sent to a client,
# `TurnCredentialMinter.kt` derives a fresh short-lived credential per `joinRoom` call from it). The
# load-bearing PRODUCTION difference is `external-ip` below.
listening-port=3478
min-port=51000
max-port=51019
realm=pzb.parteidervernunft.de
use-auth-secret
static-auth-secret=${LAPIS_TURN_SECRET}
# PRODUCTION: the VPS's real public IP, not 127.0.0.1 -- same reasoning as livekit.yaml's
# `rtc.node_ip`. Without this, coturn advertises an address real clients cannot relay through.
external-ip=${LAPIS_PUBLIC_IP}
no-tls
no-dtls
fingerprint
log-file=stdout
no-cli

# ── TURNS over TLS (port 443) -- PREPARED, DELIBERATELY INACTIVE ────────────────────────────────
# Why: a browser with a restrictive WebRTC privacy policy (Brave's Shields / fingerprinting
# protection) or a network that only permits outbound 443 can block BOTH the direct ICE path AND
# plain TURN on 3478/UDP+TCP. Symptom: audio/video never start even though the camera/microphone
# permission was granted. Reported live by an ELB board member, 2026-09-10. See
# ../production/README.adoc, "TURNS over TLS (port 443)".
#
# NOT enabled yet, and enabling it is NOT a code change: it needs (a) a DNS A record
# (turn.pzb.parteidervernunft.de -> this host's IP), (b) a real certificate for that name, and
# (c) Caddy SNI-based TCP multiplexing on 443, because Caddy already owns port 443 on this host.
# coturn itself therefore listens on an INTERNAL port, never on 443 directly.
#
# To activate, in this order: remove `no-tls` above, uncomment the three lines below, point
# cert-file/pkey-file at the real certificate, then re-run render-secrets.sh and restart coturn.
#tls-listening-port=5350
#cert-file=/etc/coturn/certs/turn-fullchain.pem
#pkey-file=/etc/coturn/certs/turn-privkey.pem
