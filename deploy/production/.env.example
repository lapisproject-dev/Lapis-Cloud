# Copy to .env in this same directory and fill in real values. .env is gitignored -- never commit
# real secrets here or anywhere else in the repo.

LAPIS_DB_NAME=lapiscloud
LAPIS_DB_USER=lapiscloud
# Generate with: openssl rand -base64 24
LAPIS_DB_PASSWORD=

# The public HTTPS origin this deployment is reachable at (used for absolute links in emails,
# OIDC/federation metadata, etc.) -- e.g. https://pzb.parteidervernunft.de
LAPIS_PUBLIC_BASE_URL=

# --- Video conferencing (Videokonferenzen Wave 1: live audio/video/screen-share/chat) ---
# Used by render-secrets.sh to render livekit.yaml/turnserver.conf from their .template files, and
# by the lapis-server container to reach LiveKit's admin API and mint client tokens/TURN
# credentials. See README.adoc "Video conferencing" for the full setup.

# This host's real public IPv4 -- LiveKit/coturn advertise it as their ICE candidate address so
# real browsers on the internet can reach them. NOT 127.0.0.1 (that's the local-dev-only value).
LAPIS_PUBLIC_IP=

# Arbitrary identifier, not a secret itself -- e.g. lapiscloud
LAPIS_LIVEKIT_API_KEY=
# Generate with: openssl rand -base64 32 (nimbus-jose-jwt refuses HMAC keys under 256 bits/32 bytes)
LAPIS_LIVEKIT_API_SECRET=
# Generate with: openssl rand -base64 32. Different from the above -- never reuse one secret for
# both LiveKit and coturn.
LAPIS_TURN_SECRET=

# Public wss:// origin browsers connect to for LiveKit signaling (Apache-proxied, TLS-terminated)
# -- e.g. wss://video.parteidervernunft.de
LAPIS_LIVEKIT_URL=
