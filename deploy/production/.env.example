# Copy to .env in this same directory and fill in real values. .env is gitignored -- never commit
# real secrets here or anywhere else in the repo.

LAPIS_DB_NAME=lapiscloud
LAPIS_DB_USER=lapiscloud
# Generate with: openssl rand -base64 24
LAPIS_DB_PASSWORD=

# The public HTTPS origin this deployment is reachable at (used for absolute links in emails,
# OIDC/federation metadata, etc.) -- e.g. https://pzb.parteidervernunft.de
LAPIS_PUBLIC_BASE_URL=

# --- Video conferencing (Videokonferenzen Wave 1: live audio/video/screen-share/chat) ---
# Used by render-secrets.sh to render livekit.yaml/turnserver.conf from their .template files, and
# by the lapis-server container to reach LiveKit's admin API and mint client tokens/TURN
# credentials. See README.adoc "Video conferencing" for the full setup.

# This host's real public IPv4 -- LiveKit/coturn advertise it as their ICE candidate address so
# real browsers on the internet can reach them. NOT 127.0.0.1 (that's the local-dev-only value).
LAPIS_PUBLIC_IP=

# Arbitrary identifier, not a secret itself -- e.g. lapiscloud
LAPIS_LIVEKIT_API_KEY=
# Generate with: openssl rand -base64 32 (nimbus-jose-jwt refuses HMAC keys under 256 bits/32 bytes)
LAPIS_LIVEKIT_API_SECRET=
# Generate with: openssl rand -base64 32. Different from the above -- never reuse one secret for
# both LiveKit and coturn.
LAPIS_TURN_SECRET=

# Public wss:// origin browsers connect to for LiveKit signaling (Apache-proxied, TLS-terminated)
# -- e.g. wss://video.parteidervernunft.de
LAPIS_LIVEKIT_URL=

# --- Video conferencing (Videokonferenzen Wave 3: externes Streaming) ---
# AES-256-GCM key SecretBox uses to encrypt stream destination RTMP keys at rest -- unrelated to
# the LiveKit/TURN secrets above, never reuse one of those for this. Generate with:
# openssl rand -base64 32
# Missing/invalid: every streaming RPC (list/create/start/pause/resume/stop) fails with a generic
# conflict error, while Wave 1/2 (calls, recording) keep working fine -- easy to miss.
LAPIS_SECRET_ENCRYPTION_KEY=

# --- Echter E-Mail-Versand (SMTP, V1.2.3) -- OPTIONAL, aber ALL-OR-NOTHING ---
# Entweder alle fünf Pflichtwerte (HOST/USERNAME/PASSWORD/FROM_ADDRESS/FROM_NAME) setzen, oder GAR
# KEINE LAPIS_SMTP_*-Variable setzen. Eine halbe Konfiguration lässt den Server beim Start mit
# einer IllegalStateException abbrechen (fail-fast) -- siehe README.adoc "E-Mail-Versand (SMTP,
# optional)". Deshalb bleiben ALLE Werte hier unten leer, exakt wie bei den anderen optionalen
# Blöcken oben (LAPIS_LIVEKIT_URL, LAPIS_SECRET_ENCRYPTION_KEY, ...) -- Beispielwerte für netcup
# (mxe9fb.netcup.net) stehen nur als auskommentierte Vorlage, NICHT vorbefüllt.
# LAPIS_SMTP_HOST=mxe9fb.netcup.net
LAPIS_SMTP_HOST=
# 465 = implizites TLS (Standard). 587 = STARTTLS (wird erzwungen, kein Klartext-Fallback).
# LAPIS_SMTP_PORT=465
LAPIS_SMTP_PORT=
LAPIS_SMTP_USERNAME=
LAPIS_SMTP_PASSWORD=
# MUSS zum authentifizierten Postfach (LAPIS_SMTP_USERNAME) passen, sonst 5xx-Ablehnung durch
# netcup.
# LAPIS_SMTP_FROM_ADDRESS=no_reply@parteidervernunft.de
LAPIS_SMTP_FROM_ADDRESS=
# PFLICHT (sobald irgendeine LAPIS_SMTP_*-Variable gesetzt ist) -- Anzeigename neben
# LAPIS_SMTP_FROM_ADDRESS. Der einzige Absendername, den Empfänger sehen -- MailTemplates
# hardcodet seit V1.2.3 keinen Produktnamen mehr (white-label, siehe MailBranding KDoc).
# LAPIS_SMTP_FROM_NAME=Partei der Vernunft
LAPIS_SMTP_FROM_NAME=
# Optional -- gesetzt: ausgehende Mails tragen einen Reply-To-Header auf diese Adresse und die
# Fußzeile lädt zum Antworten ein. Nicht gesetzt: die Fußzeile verweist stattdessen auf
# LAPIS_PUBLIC_BASE_URL -- keine Mail ohne Rückweg.
# LAPIS_SMTP_REPLY_TO=kontakt@parteidervernunft.de
LAPIS_SMTP_REPLY_TO=

# --- White-Label-Branding (V1.2.5) -- BEIDE optional, unabhängig voneinander ---
# Ersetzt nur den Titel/das Logo im Web-UI (Navbar/<title>/Login-Screen). Der Text "Betrieben mit
# Lapis Cloud" bleibt IMMER sichtbar (unentfernbar, siehe README.adoc "White-Label-Branding") --
# das hier ist reines Rebranding, keine Abschaltung der Lapis-Cloud-Herkunftsangabe.
# LAPIS_BRAND_TITLE=Partei der Vernunft
LAPIS_BRAND_TITLE=
# Absoluter Pfad INNERHALB des Containers, siehe Volume-Mount in docker-compose.yml
# ("./branding:/app/branding:ro") -- Datei einfach unter deploy/production/branding/ ablegen.
# Endung .svg/.png/.webp (Groß-/Kleinschreibung egal), max. 512 KiB.
# LAPIS_BRAND_LOGO_PATH=/app/branding/logo.svg
LAPIS_BRAND_LOGO_PATH=

# --- SEPA-Lastschriftlauf-Poller -- OPTIONAL, siehe README.adoc "SEPA-Lastschriftlauf-Poller" ---
# Auf HÖCHSTENS EINER Instanz aktivieren (PdV ODER ELB, nie beide).
LAPIS_SEPA_POLLER_ENABLED=
# Default 3600 (stündlich), Untergrenze 60.
LAPIS_SEPA_POLL_INTERVAL_SECONDS=

# --- Automatisiertes Mahnwesen (V1.2.7) -- OPTIONAL, siehe README.adoc "Automatisiertes Mahnwesen" ---
# Auf HÖCHSTENS EINER Instanz aktivieren, dieselbe Disziplin wie beim SEPA-Poller oben. Greift erst
# gemeinsam mit organization_settings.dunning_enabled (ADMIN, disclaimer-gated) UND mindestens einer
# aktiven Mahnstufe -- fünf voneinander unabhängige Sicherungen insgesamt, siehe DunningPoller/
# DunningConfig KDoc.
LAPIS_DUNNING_POLLER_ENABLED=
# Default 3600 (stündlich), Untergrenze 60.
LAPIS_DUNNING_POLL_INTERVAL_SECONDS=
# Default 200, Bereich 1..5000 -- Kosten-/DoS-Deckel pro Poll-Durchlauf.
LAPIS_DUNNING_MAX_NOTICES_PER_TICK=
# Default false -- DRITTES, unabhängiges Gate zusätzlich zu organizationSettings.postalMailEnabled.
# Automatisierter Postversand einer Mahnung kostet echtes Geld pro Brief.
LAPIS_DUNNING_POSTAL_DISPATCH_ENABLED=

# --- Zahlungsdienstleister (Stripe, V1.2.8) -- OPTIONAL, aber ALL-OR-NOTHING ---
# Entweder BEIDE Pflichtwerte setzen oder GAR KEINE LAPIS_STRIPE_*-Variable. Eine halbe
# Konfiguration bricht den Start mit einer IllegalStateException ab (fail-fast), dieselbe Disziplin
# wie bei LAPIS_SMTP_* oben. Greift zusaetzlich erst gemeinsam mit
# organization_settings.payment_gateway_enabled (ADMIN, disclaimer-gated) UND einer vollstaendigen
# Kontenzuordnung -- drei voneinander unabhaengige Gates, siehe README.adoc.
#
# Webhook-URL, die im Stripe-Dashboard einzutragen ist:
#   <LAPIS_PUBLIC_BASE_URL>/api/webhooks/stripe   (Event: checkout.session.completed)
# Der dort angezeigte Signing Secret (whsec_...) gehoert in LAPIS_STRIPE_WEBHOOK_SIGNING_SECRET.
LAPIS_STRIPE_SECRET_KEY=
LAPIS_STRIPE_WEBHOOK_SIGNING_SECRET=
# Default 300 (Bereich 60..900) -- Toleranzfenster fuer den Zeitstempel der Webhook-Signatur.
LAPIS_PSP_WEBHOOK_TOLERANCE_SECONDS=
# Default 10000.00 -- Missbrauchs-/DoS-Deckel je Spenden-Checkout.
LAPIS_PSP_MAX_CHECKOUT_AMOUNT_EUR=
# Default 60 (Bereich 10..1440) -- Gueltigkeitsdauer einer erzeugten Checkout-Session in Minuten.
LAPIS_PSP_CHECKOUT_TTL_MINUTES=
