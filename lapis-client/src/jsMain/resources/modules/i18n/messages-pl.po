#: src/jsMain/kotlin/network/lapis/cloud/client/ConferenceScreen.kt:561
msgid ""
"Sie sind über Ihren eigenen Heimserver angemeldet. Geben Sie die Raum-"
"Kennung aus Ihrer Einladung ein, um einer Besprechung auf diesem Server "
"beizutreten."
msgstr ""
