msgid "Änderung zurückgezogen."
msgstr "Modifica ritirata."

#: src/jsMain/kotlin/network/lapis/cloud/client/MemberEmailChangeProposal.kt:1
msgid "Änderung vorschlagen"
msgstr "Proponi modifica"

