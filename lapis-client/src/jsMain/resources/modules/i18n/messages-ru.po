msgstr "Физическое лицо (гражданин Германии)"

#: src/jsMain/kotlin/network/lapis/cloud/client/AccountingLabels.kt:83
msgid "Deutsches Unternehmen/Organisation"
msgstr "Немецкая компания/организация"

#: src/jsMain/kotlin/network/lapis/cloud/client/PriceOracleScreen.kt:191
