msgstr "Список"

#: src/jsMain/kotlin/network/lapis/cloud/client/MailingAttachments.kt
msgid "Anhänge"
msgstr "Вложения"

#: src/jsMain/kotlin/network/lapis/cloud/client/MailingAttachments.kt
msgid "Keine Anhänge."
msgstr "Вложений нет."

#: src/jsMain/kotlin/network/lapis/cloud/client/MailingAttachments.kt
msgid "Nach dem Senden können Anhänge nicht mehr geändert werden."
msgstr "После отправки вложения изменить нельзя."

#: src/jsMain/kotlin/network/lapis/cloud/client/MailingAttachments.kt
msgid "Datei gelöscht"
msgstr "Файл удалён"

#: src/jsMain/kotlin/network/lapis/cloud/client/MailingAttachments.kt
msgid "Dateien anhängen"
msgstr "Прикрепить файлы"

#: src/jsMain/kotlin/network/lapis/cloud/client/MailingAttachments.kt
msgid "Höchstens %1 Anhänge pro Nachricht."
msgstr "Не более %1 вложений на сообщение."

#: src/jsMain/kotlin/network/lapis/cloud/client/MailingAttachments.kt
msgid "Es sind nur noch %1 Anhänge möglich; die übrigen Dateien wurden nicht übernommen."
msgstr "Можно добавить ещё только %1 вложений; остальные файлы не добавлены."

#: src/jsMain/kotlin/network/lapis/cloud/client/MailingAttachments.kt
msgid "Lapis prüft Anhänge nicht auf Viren. Bitte laden Sie nur Dateien hoch, denen Sie vertrauen."
msgstr "Lapis не проверяет вложения на вирусы. Загружайте только файлы, которым вы доверяете."

#: src/jsMain/kotlin/network/lapis/cloud/client/MailingAttachments.kt
msgid "%1 von 5 Dateien, zusammen %2 von 20 MB."
msgstr "%1 из 5 файлов, всего %2 из 20 МБ."

#: src/jsMain/kotlin/network/lapis/cloud/client/MailingAttachments.kt
msgid "Erlaubt sind PDF, Bilder (PNG, JPEG, GIF, WebP), Word, Excel, PowerPoint, OpenDocument, TXT und CSV: höchstens 5 Dateien, 10 MB pro Datei, zusammen 20 MB."
msgstr "Разрешены: PDF, изображения (PNG, JPEG, GIF, WebP), Word, Excel, PowerPoint, OpenDocument, TXT и CSV: не более 5 файлов, 10 МБ на файл, всего 20 МБ."

#: src/jsMain/kotlin/network/lapis/cloud/client/MailingAttachments.kt
msgid "Anhänge gehen an alle Empfänger dieser Nachricht. Lapis löscht die Dateien 180 Tage nach dem Senden."
msgstr "Вложения получат все адресаты этого сообщения. Lapis удаляет файлы через 180 дней после отправки."

#: src/jsMain/kotlin/network/lapis/cloud/client/MailingAttachments.kt
msgid "„%1“ hat ein nicht unterstütztes Format. Erlaubt sind PDF, Bilder (PNG, JPEG, GIF, WebP), Word, Excel, PowerPoint, OpenDocument, TXT und CSV."
msgstr "«%1» имеет неподдерживаемый формат. Разрешены PDF, изображения (PNG, JPEG, GIF, WebP), Word, Excel, PowerPoint, OpenDocument, TXT и CSV."

#: src/jsMain/kotlin/network/lapis/cloud/client/MailingAttachments.kt
msgid "Mit „%1“ wären die Anhänge zusammen größer als 20 MB."
msgstr "С «%1» вложения вместе превысили бы 20 МБ."

#: src/jsMain/kotlin/network/lapis/cloud/client/MailingAttachments.kt
msgid "Ein Anhang mit dem Namen „%1“ ist schon vorhanden."
msgstr "Вложение с именем «%1» уже есть."

#: src/jsMain/kotlin/network/lapis/cloud/client/MailingAttachments.kt
msgid "„%1“ passt nicht zu ihrer Dateiendung oder ist beschädigt oder verschlüsselt."
msgstr "«%1» не соответствует расширению файла либо повреждён или зашифрован."

#: src/jsMain/kotlin/network/lapis/cloud/client/MailingAttachments.kt
msgid "„%1“ enthält Makros oder eingebettete Objekte und wird nicht angenommen."
msgstr "«%1» содержит макросы или встроенные объекты и не принимается."

#: src/jsMain/kotlin/network/lapis/cloud/client/MailingAttachments.kt
msgid "„%1“ hat keinen gültigen Dateinamen."
msgstr "У «%1» недопустимое имя файла."

#: src/jsMain/kotlin/network/lapis/cloud/client/MailingAttachments.kt
msgid "Die Nachricht ist kein Entwurf mehr. Anhänge können nicht mehr geändert werden."
msgstr "Сообщение больше не черновик. Вложения изменить нельзя."

#: src/jsMain/kotlin/network/lapis/cloud/client/MailingAttachments.kt
msgid "Anhänge fügen Sie nach dem Speichern beim Entwurf hinzu."
msgstr "Вложения добавляются к черновику после сохранения."

#: src/jsMain/kotlin/network/lapis/cloud/client/MailingAttachments.kt
msgid "%1 Anhang hinzugefügt."
msgid_plural "%1 Anhänge hinzugefügt."
msgstr[0] "Добавлено %1 вложение."
msgstr[1] "Добавлено %1 вложения."
msgstr[2] "Добавлено %1 вложений."

#: src/jsMain/kotlin/network/lapis/cloud/client/MailingAttachments.kt
msgid "Mit %1 Anhang (%2)."
msgid_plural "Mit %1 Anhängen (%2)."
msgstr[0] "С %1 вложением (%2)."
msgstr[1] "С %1 вложениями (%2)."
msgstr[2] "С %1 вложениями (%2)."

#: src/jsMain/kotlin/network/lapis/cloud/client/DirectMessageComposerAttachments.kt
msgid "Datei anhängen"
msgstr "Прикрепить файл"

#: src/jsMain/kotlin/network/lapis/cloud/client/DirectMessageComposerAttachments.kt
msgid "Bis zu 5 Dateien, je höchstens 10 MB, zusammen höchstens 20 MB."
msgstr "До 5 файлов, каждый не более 10 МБ, всего не более 20 МБ."

#: src/jsMain/kotlin/network/lapis/cloud/client/DirectMessageComposerAttachments.kt
msgid "Anhänge sieht nur Ihr Gesprächspartner. Lapis prüft Dateien nicht auf Viren."
msgstr "Вложения видит только ваш собеседник. Lapis не проверяет файлы на вирусы."

#: src/jsMain/kotlin/network/lapis/cloud/client/DirectMessageComposerAttachments.kt
msgid "Lapis prüft Anhänge nicht auf Viren."
msgstr "Lapis не проверяет вложения на вирусы."

#: src/jsMain/kotlin/network/lapis/cloud/client/DirectMessageComposerAttachments.kt
msgid "Bitte warten, bis alle Dateien hochgeladen sind."
msgstr "Подождите, пока все файлы будут загружены."

#: src/jsMain/kotlin/network/lapis/cloud/client/DirectMessageComposerAttachments.kt
msgid "Bitte entfernen Sie fehlgeschlagene Dateien."
msgstr "Удалите файлы, которые не удалось загрузить."

#: src/jsMain/kotlin/network/lapis/cloud/client/DirectMessageComposerAttachments.kt
msgid "Diesem Mitglied können Sie keine Dateien schicken."
msgstr "Вы не можете отправлять файлы этому участнику."

#: src/jsMain/kotlin/network/lapis/cloud/client/DirectMessageComposerAttachments.kt
msgid "Sie haben zu viele noch nicht gesendete Dateien. Bitte senden oder entfernen Sie zuerst welche."
msgstr "У вас слишком много ещё не отправленных файлов. Сначала отправьте или удалите некоторые."

#: src/jsMain/kotlin/network/lapis/cloud/client/DirectMessageComposerAttachments.kt
msgid "Anhänge konnten nicht gesendet werden. Bitte laden Sie die Dateien erneut hoch."
msgstr "Вложения не удалось отправить. Загрузите файлы заново."

